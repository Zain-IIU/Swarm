# ==========================================
# Unity generated folders — at any depth
# ==========================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# ==========================================
# IDE and editor caches
# ==========================================
.vs/
.idea/
.gradle/
.consulo/
.utmp/
ExportedObj/

# Generated Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Personal IDE settings
*.DotSettings.user
*.suo
*.user
*.userprefs
*.sln.docstates

# Generated solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.booproj
*.pidb
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# ==========================================
# Logs, temporary files, and crash reports
# ==========================================
*.log
*.tmp
*.temp
*.bak
*.orig
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# ==========================================
# Blender backups — keep original .blend files
# ==========================================
*.blend[0-9]*
*.blend[0-9]*.meta

# ==========================================
# Unity generated metadata
# ==========================================
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ==========================================
# Build outputs and exported packages
# ==========================================
*.apk
*.aab
*.app/
*.ipa
*.unitypackage
*.unitypackage.meta

# ==========================================
# Addressables generated content
# ==========================================
[Ss]erverData/
[Aa]ssets/StreamingAssets/aa*
[Aa]ssets/AddressableAssetsData/link.xml*
[Aa]ssets/AddressableAssetsData/*/*.bin*
[Aa]ssets/Addressables_Temp*

# ==========================================
# Visual Scripting generated files
# ==========================================
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ==========================================
# Unity tests and generated caches
# ==========================================
InitTestScene*.unity*
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
UIElementsSchema/
[Aa]ssets/[Ss]ceneDependencyCache*

# ==========================================
# Operating system files
# ==========================================
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

